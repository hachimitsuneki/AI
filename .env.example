# These are local runtime-profile defaults, not final model or product decisions.
COMPANION_HOST=127.0.0.1
COMPANION_PORT=8765
COMPANION_DB_PATH=data/text-v01.sqlite3
OLLAMA_BASE_URL=http://127.0.0.1:11434
COMPANION_MAIN_MODEL=qwen3.5:2b-q4_K_M
COMPANION_EMBEDDING_MODEL=nomic-embed-text:latest
COMPANION_CONTEXT_BUDGET_TOKENS=8192
COMPANION_MAX_GENERATION_TOKENS=1024
COMPANION_RETRIEVAL_MAX_RESULTS=12
COMPANION_RETRIEVAL_CANDIDATE_LIMIT=500
COMPANION_RETRIEVAL_RRF_K=60
COMPANION_REQUEST_TIMEOUT_SECONDS=180
COMPANION_ANALYZER_TIMEOUT_SECONDS=60
# Ollama thinking control: false, true, low, medium, high, max, or auto.
# This provisional foreground profile tests false for a thinking-capable Qwen model.
COMPANION_THINK=false
COMPANION_PROFILE_ID=local-provisional-v1
COMPANION_IDENTITY_NAME=AI
COMPANION_IDENTITY_ROLE=digital companion
